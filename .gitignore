# ── Rust ──
anykey-engine/target*/
anykey-tray/target*/
**/*.rs.bk
anykey-engine/stderr.txt

# ── Python ──
__pycache__/
*.py[cod]
venv/
venv_old_broken/
.venv/
*.egg-info/

# ── 构建产物 ──
engines/rust/
build/dist/
build/build/
*.exe
*.pdb
*.dll

# ── 备份（绝不入库）──
backups/
**/backups/

# ── 日志 ──
*.log
